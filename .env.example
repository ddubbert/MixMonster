# Copy to .env and fill in. Never commit .env.
MIXMONSTER_HOST=<mixmonster_host>
MIXMONSTER_PORT=<mixmonster_port>
DB_USER=<db_user>
DB_PASSWORD=<db_password>
DB_HOST=<db_host>
DB_PORT=<db_port>
DB_DATABASE=<db_database>
DB_AUTHSOURCE=<db_authsource>
# --- Keycloak / Postman test values (fill in locally) ---
# Keycloak client secret, realm HybridLR, client "mixmonster" (also in mixmonster_backend/keycloak.json)
KEYCLOAK_MIXMONSTER_CLIENT_SECRET=<keycloak_mixmonster_client_secret>
# Postman "Keycloak Test": client_secret
POSTMAN_KEYCLOAK_CLIENT_SECRET=<postman_keycloak_client_secret>
# Postman "Keycloak Test": old access_token
POSTMAN_ACCESS_TOKEN=<postman_access_token>
